# Shared
NODE_ENV=development
AWS_REGION=us-east-1
DATABASE_URL=postgres://hiresphere:hiresphere123@postgres:5432/hiresphere
INTERNAL_SERVICE_TOKEN=change-me

# Gateway / Cognito
PORT=8080
BYPASS_AUTH=true
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid

# Service URLs
PROFILE_SERVICE_URL=http://profile-service:4001
BOOKING_SERVICE_URL=http://booking-service:4002
SUBMISSION_SERVICE_URL=http://submission-service:4003
MESSAGING_SERVICE_URL=http://messaging-service:4004
EVALUATION_SERVICE_URL=http://evaluation-service:4005
LIVE_SESSION_SERVICE_URL=http://live-session-service:4006

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_LOGIN_WITH_EMAIL=true

# Submission storage
S3_BUCKET=
S3_PUBLIC_BASE_URL=
UPLOAD_DIR=/app/uploads
